{
  "name": "Luan Allround Service | Garten- & Landschaftsbau",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap || exit 0",
    "build:gh": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "include": [
      "/",
      "/leistungen",
      "/projekte",
      "/galerie",
      "/blog",
      "/ueber-uns",
      "/kontakt"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@types/node": "^22.14.0",
    "@types/react-helmet": "^6.1.11",
    "@vitejs/plugin-react": "^5.0.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.554.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.6",
    "sweetalert2": "^11.26.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-sitemap": "^0.8.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "react-snap": "^1.23.0"
  }
}
